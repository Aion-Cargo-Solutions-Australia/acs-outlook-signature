    "serve": "npx http-server dist -S -p 3000"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "office-addin-manifest": "^2.0.0"
  }
}
