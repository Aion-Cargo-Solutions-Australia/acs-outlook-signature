{
  "name": "acs-outlook-signature",
  "version": "1.0.0",
  "private": true,
  "description": "ACS unified Outlook signature add-in (event-based, NAA + Microsoft Graph)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --test test/*.test.mjs",
